<mujoco model="g1 scene">
    <include file="g1_mjx_w_racket_w_ball.xml"/>

    <statistic center="0 0 0.7" extent="1.2" meansize="0.04"/>

    <visual>
        <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
        <rgba force="1 0 0 1"/>
        <global azimuth="140" elevation="-20"/>
        <map force="0.01"/>
        <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
        <quality shadowsize="8192"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
        <!-- assets/tennis/tennis_court_green.png -->
        <texture type="2d" name="groundplane" file="assets/tennis/tennis_court_green.png"/>
        <material name="groundplane" texture="groundplane" texuniform="false" texrepeat="1 1" reflectance="0"/>
    </asset>

    <worldbody>
        <!--  half of a real doubles court: length 23.77m (half 11.885),
             width 10.97m (half 5.485). Net sits at x=0, court center; the robot's playing
             half is x in [0, 11.885] 
             (robot is in one hlaf, balls arrive over the net from the other side). -->
        <geom name="floor" type="plane" size="11.885 5.485 0.01" material="groundplane"/>

        <!-- Net: static spans the full doubles width.
             Real nets sag from 1.07m (posts) to 0.914m (center); modeled here as a
             uniform 0.914m (center height). -->
        <geom name="net" type="box" pos="0 0 0.457" size="0.02 5.485 0.457"
              rgba="0.05 0.05 0.05 0.85" contype="0" conaffinity="0"/>
        <geom name="net_tape" type="box" pos="0 0 0.914" size="0.03 5.485 0.02"
              rgba="0.95 0.95 0.95 1" contype="0" conaffinity="0"/>
    </worldbody>

    <keyframe>
        <key name="home"
             qpos="
      0 0 0.785
      1 0 0 0
      -0.1 0 0 0.3 -0.2 0
      -0.1 0 0 0.3 -0.2 0
      0 0 0
      0.2 0.2 0 1.28 0 0 0
      0.2 -0.2 0 1.28 0 0 0
      0 0 1.5
      1 0 0 0
      "
             ctrl="
      -0.1 0 0 0.3 -0.2 0
      -0.1 0 0 0.3 -0.2 0
      0 0 0
      0.2 0.2 0 1.28 0 0 0
      0.2 -0.2 0 1.28 0 0 0
      "/>
        <key name="knees_bent"
             qpos="
      0 0 0.755
      1 0 0 0
      -0.312 0 0 0.669 -0.363 0
      -0.312 0 0 0.669 -0.363 0
      0 0 0.073
      0.2 0.2 0 0.6 0 0 0
      0.2 -0.2 0 0.6 0 0 0
      0 0 1.5
      1 0 0 0
      "
             ctrl="
      -0.312 0 0 0.669 -0.363 0
      -0.312 0 0 0.669 -0.363 0
      0 0 0.073
      0.2 0.2 0 0.6 0 0 0
      0.2 -0.2 0 0.6 0 0 0
    "/>
    </keyframe>
</mujoco>
